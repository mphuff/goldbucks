	"authors": [
		"Micah Huff"
	],
	"license": "LicenseRef-All-Rights-Reserved",
	"icon": "assets/goldbucks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.goldbucks.GoldbucksMod"
		],
		"client": [
			"com.goldbucks.client.GoldbucksModClient"
		]
	},
	"mixins": [
		"goldbucks.mixins.json"
	],
	"depends": {
